# ---- Supabase ----
# Project Settings -> API. The publishable (anon) key is safe in the browser;
# RLS + the column grants in supabase/schema.sql are what protect the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret (service_role) key. SERVER ONLY - it bypasses RLS entirely.
# Used by the agency console for writes, always behind requireAgency().
SUPABASE_SERVICE_ROLE_KEY=

# ---- Vercel AI Gateway ----
# Needs a credit card on the Vercel team before it serves requests.
AI_GATEWAY_API_KEY=

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared secret so only Vercel Cron can trigger scheduled publishing.
CRON_SECRET=

# ---- Platform OAuth (blank = demo connect) ----
META_APP_ID=
META_APP_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

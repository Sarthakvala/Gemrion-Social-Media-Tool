# Copy to worker/.env (git-ignored) and fill in. Same values as the web app's
# NEXT_PUBLIC_SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY.
# The service role key bypasses all row level security: keep worker/.env private.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional
# WORKER_ID=desk-pc            # shown on the Jobs page; defaults to hostname-pid
# WORKER_KINDS=worker_ping     # job kinds to claim; defaults to all this worker supports
# POLL_MS=5000                 # how often to check an empty queue
# HEARTBEAT_MS=60000           # how often a running job refreshes its lock
